{
  "name": "minefield",
  "private": true,
  "version": "0.67.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:offline": "tsc && vite build --base=./ --outDir dist-offline",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node scripts/capture.mjs",
    "boot": "node scripts/boot-shot.mjs",
    "icons": "node scripts/icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "offline": "node scripts/offline.mjs",
    "persist": "node scripts/persist.mjs",
    "pack:offline": "npm run build:offline && node scripts/pack-offline.mjs",
    "pack:app": "npm run build:offline && node scripts/pack-app.mjs",
    "pack:win": "npm run build:offline && node scripts/pack-win.mjs"
  },
  "dependencies": {
    "zx-kit": "^0.46.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "semantic-release": "^25.0.9",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
